/**
 * Создаёт отдельную Google-Форму «EAT-10 — опросник глотания».
 * Заполняется дважды: до лечения и после (поле «Этап» это различает).
 *
 * Как запустить:
 *  1. Открой script.google.com → «Новый проект».
 *  2. Вставь весь этот код, сохрани (значок дискеты).
 *  3. Вверху выбери функцию createEAT10Form → нажми «Выполнить».
 *  4. Разреши доступ (один раз).
 *  5. Внизу откроется «Журнал выполнения» — там будут ДВЕ ссылки:
 *     «для заполнения» (её отправляешь родителям) и «для редактирования».
 *  6. Форма появится в «Моём Диске» — перетащи её в свою папку с опросниками.
 */
function createEAT10Form() {
  var q = [
    'Из-за проблемы с глотанием я теряю вес',
    'Из-за проблемы с глотанием мне трудно питаться вне дома',
    'Проглатывание жидкостей требует усилий',
    'Проглатывание твёрдой пищи требует усилий',
    'Проглатывание таблеток требует усилий',
    'Глотание болезненно',
    'Из-за проблемы с глотанием удовольствие от еды снижено',
    'При глотании пища застревает в горле',
    'Во время еды я кашляю',
    'Глотание вызывает стресс'
  ];

  var form = FormApp.create('EAT-10 — опросник глотания');
  form.setDescription(
    'По каждому пункту выберите значение от 0 до 4: 0 — нет проблемы, 4 — серьёзная проблема. ' +
    'Сумма баллов 0–40. Результат 3 и больше означает нарушение глотания.'
  );
  try { form.setCollectEmail(false); } catch (e) {}

  form.addTextItem()
      .setTitle('Код пациента (выдаёт врач)')
      .setRequired(true);

  form.addMultipleChoiceItem()
      .setTitle('Этап заполнения')
      .setChoiceValues(['До лечения', 'После лечения'])
      .setRequired(true);

  for (var i = 0; i < q.length; i++) {
    form.addScaleItem()
        .setTitle((i + 1) + '. ' + q[i])
        .setBounds(0, 4)
        .setLabels('нет проблемы', 'серьёзная проблема')
        .setRequired(true);
  }

  Logger.log('Ссылка для заполнения (родителям): ' + form.getPublishedUrl());
  Logger.log('Ссылка на редактирование: ' + form.getEditUrl());
}
