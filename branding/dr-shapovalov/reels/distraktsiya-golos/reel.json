  "captions": [
    {
      "t": 0.45,
      "end": 2.9,
      "text": "Нижняя челюсть у ребёнка *недоразвита*?"
    },
    {
      "t": 2.96,
      "end": 4.2,
      "text": "Есть *выход*"
    },
    {
      "t": 4.28,
      "end": 7.05,
      "text": "*Дистракционный остеогенез*"
    },
    {
      "t": 7.1,
      "end": 10.68,
      "text": "Распил челюсти в области *угла*"
    },
    {
      "t": 10.74,
      "end": 14.95,
      "text": "…и *миниатюрный* дистракционный аппарат"
    },
    {
      "t": 15.02,
      "end": 17.3,
      "text": "Установка — *через рот*"
    },
    {
      "t": 17.38,
      "end": 21.5,
      "text": "Не мешает *разговору* и общению"
    },
    {
      "t": 21.58,
      "end": 24.1,
      "text": "…ни речи, ни *приёму пищи*"
    },
    {
      "t": 24.16,
      "end": 27.7,
      "text": "Кость рассекают, ставят *аппарат*"
    },
    {
      "t": 27.78,
      "end": 30.9,
      "text": "Ждём в среднем *5–6 дней*"
    },
    {
      "t": 30.94,
      "end": 32.66,
      "text": "…и *активируем* аппарат"
    },
    {
      "t": 32.72,
      "end": 37.82,
      "text": "В зоне дистракции — *регенерат*"
    },
    {
      "t": 37.88,
      "end": 39.7,
      "text": "*Новая костная ткань*"
    },
    {
      "t": 39.75,
      "end": 43.6,
      "text": "Детская ЧЛХ · *@dr__shapovalov*"
    }
  ],
